# Public site key for the Turnstile widget. This key is safe to expose in the browser.
# Create a Turnstile site (action "contact") at https://dash.cloudflare.com/sign-up/turnstile
VITE_TURNSTILE_SITE_KEY=

# Private key used by the server function to validate Turnstile tokens. Keep secret.
TURNSTILE_SECRET_KEY=

# Resend API key for delivering contact-form submissions by email.
# Create an API key at https://resend.com/api-keys
RESEND_API_KEY=

# Verified sender address in Resend (e.g. "Site <no-reply@yourdomain.com>").
# Must be a domain you verified in Resend, or use their @resend.dev sandbox to start.
RESEND_FROM_EMAIL=

# Optional display name for the sender (defaults to the site title).
RESEND_FROM_NAME=

# Optional override for the submission destination. Defaults to the doctor's
# contact email in src/content/site.ts.
RESEND_TO_EMAIL=
